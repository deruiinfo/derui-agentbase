# ===== 复制为 .env 并修改（.env 不入库）=====

# 数据库
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
APP_DB_ROLE=app_user
APP_DB_PASSWORD=change-me-too

# 连接串（应用角色 NOBYPASSRLS → RLS 生效）
DATABASE_URL_ADMIN=postgres://postgres:change-me@db:5432/app
DATABASE_URL_APP=postgres://app_user:change-me-too@db:5432/app

# JWT
APP_JWT_SECRET=change-me-to-a-long-random-string
APP_JWT_EXPIRE_HOURS=2

# 初始管理员（首次启动自动创建；单租户）
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=
DEFAULT_TENANT_NAME=Default Organization

# 找回密码 / 邮件（可选）
PUBLIC_BASE_URL=            # 生成重置链接的前缀，如 http://<YOUR_HOST>:8080
AUTH_EXPOSE_DEV_TOKENS=false  # true=开发态在响应回显重置链接（生产必须 false）
SMTP_HOST=                  # 留空=控制台邮件（开发）；配置则用 nodemailer 发信
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@derui.local
MFA_ISSUER=derui-admin

# OIDC SSO（client_secret 用此密钥加密存储；留空则回退用 JWT 密钥）
OIDC_SECRET_KEY=

# 登录锁定
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=30

# 对外端口
WEB_PORT=8080
